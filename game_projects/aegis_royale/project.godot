; 原创战术大逃杀原型（Godot 4.8）
config_version=5

[application]
config/name="Aegis Royale Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.18, 0.28, 1)

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
fire={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
aim={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
build_toggle={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
build_wall={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
build_floor={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
build_ramp={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
build_roof={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52)]}
edit_piece={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
rotate_piece={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":71)]}
simple_mode={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":86)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Players"
3d_physics/layer_3="Builds"
3d_physics/layer_4="Loot"
